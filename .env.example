# Copy with: python3 scripts/setup.py
DATABASE_PASSWORD=replace-with-generated-secret
JWT_SECRET=replace-with-at-least-48-random-characters
MONGO_ROOT_PASSWORD=replace-with-generated-secret
MONGO_PASSWORD=replace-with-generated-secret

# Development only. Production: SPRING_PROFILES_ACTIVE=prod, DEMO_SEED=false,
# COOKIE_SECURE=true, real HTTPS origin, and fresh database volumes.
SPRING_PROFILES_ACTIVE=dev
DEMO_SEED=true
COOKIE_SECURE=false
WEB_PORT=8088
FRONTEND_URL=http://localhost:8088
ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:5173,http://127.0.0.1:5173

# Optional: disabled until you configure it. Never put a key in VITE_ variables.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Local Mailpit is included in development Compose; no external email is sent.
MAIL_ENABLED=true
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@roadsaathi.example

STORAGE_MODE=local
# For S3 mode: create a private bucket and configure its region/endpoint/keys.
STORAGE_ENDPOINT=
STORAGE_BUCKET=roadsaathi
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Set only for first production startup; remove after provisioning.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
